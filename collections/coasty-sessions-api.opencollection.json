{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coasty Public keys sessions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List active sessions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://coasty.ai/v1/sessions",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "List active sessions"
        },
        {
          "info": {
            "name": "Create a stateful CUA session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://coasty.ai/v1/sessions",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              },
              {
                "name": "X-LLM-Provider",
                "value": ""
              },
              {
                "name": "X-LLM-Api-Key",
                "value": ""
              },
              {
                "name": "X-LLM-Model",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Persistent session with a 2-hour (7200s) idle TTL, reset on each predict/reset; expires_at is returned. A predict/reset against an expired or unknown session is a 404 SESSION_NOT_FOUND. Maintains trajectory across predictions. Concurrent-session limits are tier- and deployment-configured; clients must handle 429 responses instead of hardcoding a tier limit."
        },
        {
          "info": {
            "name": "Get session info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://coasty.ai/v1/sessions/:session_id",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Stateful CUA session identifier (1-128 URL-safe characters)."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get session info"
        },
        {
          "info": {
            "name": "Delete a session",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://coasty.ai/v1/sessions/:session_id",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Stateful CUA session identifier (1-128 URL-safe characters)."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Delete a session"
        },
        {
          "info": {
            "name": "Predict within an existing session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://coasty.ai/v1/sessions/:session_id/predict",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Stateful CUA session identifier (1-128 URL-safe characters)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Predict within an existing session"
        },
        {
          "info": {
            "name": "Reset session state",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://coasty.ai/v1/sessions/:session_id/reset",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Stateful CUA session identifier (1-128 URL-safe characters)."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Reset session state"
        }
      ]
    }
  ],
  "bundled": true
}